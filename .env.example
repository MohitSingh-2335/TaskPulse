# ==========================================================
# TaskPulse Environment Configuration Template
# Copy this file to .env and customize your settings
# ==========================================================

# 1. Database Mode: 'sqlite' (Local zero-cost, default) or 'supabase'
DATABASE_MODE=sqlite
SQLITE_DB_PATH=data/task_engine.db

# Optional Supabase (If using cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# 2. AI Provider Settings: 'auto' (Local -> Groq -> Heuristic), 'local', or 'groq'
AI_PROVIDER=auto
GROQ_API_KEY=your_groq_api_key_here
LOCAL_OLLAMA_URL=http://localhost:11434
LOCAL_MODEL_NAME=llama3:8b

# 3. Calendar & Scheduling Configuration
DEFAULT_TIME_ZONE=Asia/Kolkata
SCHEDULE_START_HOUR=7
SCHEDULE_BUFFER_MINUTES=15
GOOGLE_CALENDAR_NAME=TaskPulse
# GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# 4. Web Application Server
PORT=5000
HOST=127.0.0.1
DEBUG=True
